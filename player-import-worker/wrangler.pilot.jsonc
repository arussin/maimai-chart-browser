{
  // Approved hosted pilot only. The default wrangler.jsonc stays disabled.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "maimai-player-imports",
  "main": "worker.mjs",
  "account_id": "30f2b0382e0303b0f28cb2fe2e5c1320",
  "compatibility_date": "2026-09-21",
  "workers_dev": false,
  "preview_urls": false,
  "limits": {"cpu_ms": 1000},
  "vars": {"MAISHIFT_ENABLED": "true"},
  "ratelimits": [{
    "name": "CLIENT_LIMITER", "namespace_id": "202609220001",
    "simple": {"limit": 10, "period": 60}
  }],
  "durable_objects": {"bindings": [{"name": "PROFILE_LIMITER", "class_name": "ProfileLimiter"}]},
  "migrations": [{"tag": "v1", "new_sqlite_classes": ["ProfileLimiter"]}],
  "observability": {
    "enabled": false,
    "logs": {"enabled": false, "invocation_logs": false},
    "traces": {"enabled": false}
  },
  "logpush": false,
  "routes": [{
    "pattern": "maimai.party/api/player-import/maishift",
    "zone_id": "62aa723b24ffe5f4db3d1eff5040b3f8"
  }]
}
