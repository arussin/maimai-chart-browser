{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "maimai-private-usage",
  "main": "worker.ts",
  "compatibility_date": "2026-09-22",
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "USAGE_ENABLED": "false"
  },
  "d1_databases": [
    {
      "binding": "USAGE_DB",
      "database_name": "maimai-usage-local",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": false
  },
  "logpush": false
}
